generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Multi-Tenancy Core ---
model companies {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(255)
  subdomain  String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)

  company_codes company_codes[]
  roles         roles[]
  users         users[]
  events        events[]
  calendars     calendars[]
  meetings      meetings[]
}

model company_codes {
  id         String   @id @default(uuid())
  company_id String
  code       String   @unique @db.VarChar(50)
  is_active  Boolean  @default(true)

  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

// --- Dynamic RBAC Engine ---
model features {
  id   String @id @default(uuid())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  role_features role_features[]
}

model roles {
  id         String   @id @default(uuid())
  company_id String
  name       String   @db.VarChar(100)

  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users      users[]
  role_features role_features[]
}

model role_features {
  role_id    String
  feature_id String

  role       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  feature    features @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@id([role_id, feature_id])
}

// --- Entities (Isolated by company_id) ---

model users {
  id            Int      @id @default(autoincrement())
  company_id    String?
  role_id       String?
  email         String   @unique @db.VarChar(255)
  password_hash String
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  company       companies? @relation(fields: [company_id], references: [id], onDelete: SetNull)
  role          roles?     @relation(fields: [role_id], references: [id], onDelete: SetNull)

  calendar      calendars?
  meetings_created       meetings[]             @relation("meeting_creator")
  events_created         events[]               @relation("event_creator")
  meeting_participations meeting_participants[]
  event_participations   event_participants[]
  notifications          notifications[]
}

model calendars {
  calendar_id Int     @id @default(autoincrement())
  company_id  String
  user_id     Int     @unique
  
  company     companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  meetings    meetings[]
}

model meetings {
  meeting_id   Int      @id @default(autoincrement())
  company_id   String
  calendar_id  Int
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  start_time   DateTime @db.Timestamp(6)
  end_time     DateTime @db.Timestamp(6)
  created_by   Int
  status       String   @default("scheduled") @db.VarChar(50)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  company      companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  calendar     calendars @relation(fields: [calendar_id], references: [calendar_id], onDelete: Cascade)
  creator      users     @relation("meeting_creator", fields: [created_by], references: [id])
  participants meeting_participants[]
}

model meeting_participants {
  id           Int      @id @default(autoincrement())
  meeting_id   Int
  user_id      Int
  status       String   @default("pending") @db.VarChar(50)

  meeting      meetings @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade)
  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([meeting_id, user_id])
}

model events {
  event_id      Int      @id @default(autoincrement())
  company_id    String
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  event_type    String   @db.VarChar(100)
  start_date    DateTime @db.Timestamp(6)
  end_date      DateTime @db.Timestamp(6)
  location      String?  @db.VarChar(255)
  created_by    Int
  created_at    DateTime @default(now()) @db.Timestamp(6)

  company       companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator       users     @relation("event_creator", fields: [created_by], references: [id])
  participants  event_participants[]
  
  generated_posters generated_posters[]
}

model event_participants {
  id            Int      @id @default(autoincrement())
  event_id      Int
  user_id       Int
  status        String   @default("registered") @db.VarChar(50)

  event         events   @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  user          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
}

model poster_templates {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  event_type       String             @db.VarChar(100)
  file_path        String             @db.VarChar(500)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  
  generated_posters generated_posters[]
  
  @@index([event_type])
  @@index([is_active])
}

enum Status {
  pending
  completed
  failed
}

model generated_posters {
  id           Int               @id @default(autoincrement())
  event_id     Int
  template_id  Int
  poster_path  String            @db.VarChar(500)
  generated_at DateTime          @default(now()) @db.Timestamp(6)
  status       Status            @default(pending)
  
  template     poster_templates  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  event        events            @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  
  @@index([event_id])
  @@index([template_id])
  @@index([status])
  @@index([generated_at])
}

model notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String   @db.Text
  link       String?  @db.VarChar(500)
  is_read    Boolean  @default(false)
  expires_at DateTime? @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
}
